#include "cdnn_ref.h"

// INT4 D4W4 GEMM scheduled like the 20210701 fc_int8 CDNN images.
//
// One core owns one engine. The MAC core only issues mm_int4. The cluster
// barrier is the join after every engine has queued its tile, not a wait
// inside the MAC thread.
//
//   core 0  DMAIN_0   HBM -> L2DW          A panel
//   core 1  DMAIN_1   idle in steady state (B was loaded in the prologue)
//   core 2  MAC       L1D x L1W -> L1E     mm_int4 D4W4
//   core 3  DS_0      L2DW -> L1D
//   core 4  DS_1      idle in steady state
//   core 5  EW        L1E -> L2E
//   core 6  RS        L2E -> L2R
//   core 7  DMAOUT    L2R -> HBM
//
// In step s the engines issue different tiles so a global xfence between
// steps orders DMA before DS before MAC before the store chain:
//   DMA(s), DS(s-1), MAC(s-2), EW(s-3), RS(s-4), DMAOUT(s-5)
// Two buffers of each SRAM stage. B (the small N side) is loaded once into
// L1W before the pipe. Requires k_tile == K, grid 4x8, inner_reps == 1.
// Same ABI and symbol as cdnn_mac_int4_gemm so the existing host can launch it.

static inline __device__ _global_ptr_ const int8_t* b_panel(
    _global_ptr_ const int8_t* B, int k0, int n0, int k_tile, int N, int nn,
    int packed_k) {
    int npan = N / nn;
    int panel = (k0 / k_tile) * npan + (n0 / nn);
    return B + panel * packed_k * nn;
}

static inline __device__ int my_engine(int cid) {
    if (cid == 0) return DMAIN_0;
    if (cid == 2) return MAC;
    if (cid == 3) return DS_0;
    if (cid == 5) return EW;
    if (cid == 6) return RS;
    if (cid == 7) return DMAOUT;
    return -1;
}

static inline __device__ void issue_dma_a(_global_ptr_ const int8_t* gm, int l2_byte,
                                          int nbytes) {
    int8_t* l2 = (int8_t*)0 + l2_byte;
    dma_cfg((DMA_L2_0 | DMA_INT8), (DMA_GM | DMA_INT8 | highptr(gm)), 0.0f);
    dma_i(l2, lowptr(gm), nbytes);
}

static inline __device__ void issue_ds_a(int l2_byte, v32i8* l1, int mm, int packed_k) {
    int8_t* l2 = (int8_t*)0 + l2_byte;
    ds_shuffle_cfg_datatype(DS_INT8);
    ds_shuffle_cfg_blkx(packed_k);
    ds_cfg_output_bank(NBANKS);
    int l1_iter = 0;
    int8_t* l2_ptr = l2;
    int row_stride = roundup16(packed_k);
    for (int i = 0; i < mm; i += 2 * NBANKS) {
        ds_shuffle_batch(&l1[l1_iter][0], l2_ptr, packed_k, DS_L1D);
        l2_ptr += NBANKS * packed_k;
        ds_shuffle_batch(&l1[l1_iter][1], l2_ptr, packed_k, DS_L1D);
        l2_ptr += NBANKS * packed_k;
        l1_iter += row_stride;
    }
}

static inline __device__ void issue_mac(int N, int nn_tile, int nstrips, int mm, int k_tile,
                                        int l1w_dim, int w_stride, int a_off, v16f32* l1e) {
    v32i8* l1d = &((v32i8*)0)[a_off];
    mm_cfg_stride(1);
    mm_cfg_dequant_scale(1.0f);
    mm_cfg_basic_int8(k_tile, mm, mm);
    for (int n0 = 0; n0 < N; n0 += nn_tile) {
        v32i8* l1w = &((v32i8*)0)[(n0 / nn_tile) * w_stride];
        int base = (n0 / 32) * mm * 2;
        for (int ns = 0; ns < nstrips; ns++) {
            mm_int4(&l1e[base + ns * mm * 2], l1d, &l1w[ns * l1w_dim], MAC_INT8_D4W4);
        }
    }
}

static inline __device__ void issue_ew(v16f32* l1e, v16f32* l2e, int mm, int nn) {
    int nblocks = roundup_div16(nn);
    ew_cfg_activation_type(EW_NOACT);
    ew_cfg_coeff_scalar(1.0f, 0.0f, 0.0f);
    ew_cfg_findmax(0, 0.0f);
    ew_cfg_stream_size(mm * nblocks);
    ew_cfg_col_size(NBANKS);
    ew_dsmadd(l2e, l1e, l1e, EW_L2E);
}

static inline __device__ void issue_rs(v16f32* l2e, v16f32* l2r, int mm, int nn) {
    int nblocks = roundup_div16(nn);
    rs_row_cfg_stride(1, nblocks);
    rs_row_cfg_loop(mm);
    for (int i = 0; i < nblocks; i++) {
        rs_row_batch(&l2r[i][0], &l2e[i * mm][0], NBANKS);
    }
}

static inline __device__ void issue_dmaout(_global_ptr_ float* gm, v16f32* l2r, int mm, int nn,
                                           int ld) {
    dma_cfg((DMA_GM | DMA_FP32 | highptr(gm)), (DMA_L2R | DMA_FP32), 0.0f);
    dma_cfg_2d(mm, ld * (int)sizeof(float), roundup16(nn) * (int)sizeof(float));
    dma_o_2d(lowptr(gm), l2r, nn * (int)sizeof(float));
}

__global__ void cdnn_mac_int4_gemm(float* C, const int8_t* A, const int8_t* B,
                                   int M, int N, int K, int mm, int nn_tile,
                                   int k_tile, int inner_reps) {
    int cid = core_id();
    int ncores = core_num();
    if (cid >= ncores || ncores < 8 || inner_reps != 1 || k_tile < K) {
        return;
    }
    int ncl = cluster_num();
    int cl = cluster_id();
    if (ncl < 1) {
        ncl = 1;
    }
    int rows_per = M / ncl;
    int m0 = cl * rows_per;
    int m1 = m0 + rows_per;
    int packed_K = K / 2;
    int packed_k = k_tile / 2;
    int nbytes = mm * packed_k;
    int l1w_dim = roundup16(packed_k);
    int nstrips = roundup_div32(nn_tile);
    int w_stride = nstrips * l1w_dim;
    int d_stride = roundup16(packed_k);
    int l1e_stride = (N / 32) * mm * 2;
    int l2e_stride = roundup_div16(N) * mm;

    if (cid == 0) {
        for (int n0 = 0; n0 < N; n0 += nn_tile) {
            _global_ptr_ const int8_t* Bp =
                b_panel(B, 0, n0, k_tile, N, nn_tile, packed_k);
            v32i8* dst = &((v32i8*)0)[(n0 / nn_tile) * w_stride];
            load_int8_b_panel(Bp, packed_k, nn_tile, nn_tile, dst);
        }
    }
    sync();

    int ntiles = 0;
    if (m0 < m1) {
        ntiles = (m1 - m0) / mm;
    }
    int mydev = my_engine(cid);
    int held = 0;
    int steps = ntiles + 5;
    for (int step = 0; step < steps; step++) {
        if (held) {
            xfence_unlock(mydev);
            held = 0;
        }
        sync();
        int tile = -1;
        if (cid == 0) tile = step;
        else if (cid == 3) tile = step - 1;
        else if (cid == 2) tile = step - 2;
        else if (cid == 5) tile = step - 3;
        else if (cid == 6) tile = step - 4;
        else if (cid == 7) tile = step - 5;
        if (tile < 0 || tile >= ntiles || mydev < 0) {
            continue;
        }
        int buf = tile & 1;
        int m = m0 + tile * mm;
        xfence_lock(mydev);
        if (cid == 0) {
            issue_dma_a(gptr_i8(A, (long long)m * packed_K), buf * nbytes, nbytes);
        } else if (cid == 3) {
            v32i8* l1 = &((v32i8*)0)[buf * d_stride];
            issue_ds_a(buf * nbytes, l1, mm, packed_k);
        } else if (cid == 2) {
            v16f32* l1e = &((v16f32*)0)[buf * l1e_stride];
            issue_mac(N, nn_tile, nstrips, mm, k_tile, l1w_dim, w_stride,
                      buf * d_stride, l1e);
        } else if (cid == 5) {
            v16f32* l1e = &((v16f32*)0)[buf * l1e_stride];
            v16f32* l2e = &((v16f32*)0)[buf * l2e_stride];
            issue_ew(l1e, l2e, mm, N);
        } else if (cid == 6) {
            v16f32* l2e = &((v16f32*)0)[buf * l2e_stride];
            v16f32* l2r = (v16f32*)(buf * 65536);
            issue_rs(l2e, l2r, mm, N);
        } else if (cid == 7) {
            v16f32* l2r = (v16f32*)(buf * 65536);
            issue_dmaout(gptr_f32(C, (long long)m * N), l2r, mm, N, N);
        }
        held = 1;
    }
    if (held) {
        xfence_unlock(mydev);
    }
    sync();
}
